# ── Database ──────────────────────────────────────────────────────────────
# Get this from Railway after creating a Postgres database
DATABASE_URL=postgresql://username:password@host:5432/mydubaipartslink

# ── JWT Secret ────────────────────────────────────────────────────────────
# Change this to any long random string — keep it secret!
JWT_SECRET=change_this_to_a_long_random_secret_string_at_least_32_chars
JWT_EXPIRES_IN=30d

# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Email (for order confirmations) ───────────────────────────────────────
# Use your Gmail — enable "App Passwords" in Google Account settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=MyDubaiPartsLink <your@gmail.com>

# ── Formspree (optional backup) ───────────────────────────────────────────
FORMSPREE_ID=xkjnbenl

# ── Admin ─────────────────────────────────────────────────────────────────
ADMIN_SECRET=change_this_admin_secret
